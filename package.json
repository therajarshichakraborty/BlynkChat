{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "Relay is a real-time chat app for 1:1 chats, groups, rooms and communities on mobile, tablet and desktop.",
  "scripts": {
    "dev": "next dev -p 4040",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run build"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^5"
  }
}
