{
  "name": "backend of real-time chat app",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "bun --watch ./server.ts",
    "build": "tsc && cp ./package.json ./dist",
    "start": "bun ./dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check .",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "nodejs",
    "express",
    "socket.io",
    "mongodb",
    "redis",
    "postgresql",
    "typescript",
    "drizzle-orm",
    "zod",
    "passport",
    "passport-jwt",
    "bcryptjs",
    "jsonwebtoken",
    "cookie-parser",
    "cors",
    "dotenv",
    "helmet",
    "winston",
    "cloudinary"
  ],
  "author": "Rajarshi Chakraborty",
  "license": "ISC",
  "description": "A real-time chat app build using socket i/o and express",
  "dependencies": {
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/bun": "^1.4.2",
    "@types/morgan": "^1.9.10",
    "@types/node-cron": "^3.0.11",
    "@types/winston": "^2.4.4",
    "argon2": "^0.45.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.6",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "install": "^0.13.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.19.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "passport": "^0.7.0",
